# Copy this file to .env.local and fill in real values from your Supabase
# project dashboard (Settings -> API). .env.local is git-ignored — never
# commit real keys.

# Safe to expose in the browser (every table is protected by Row Level
# Security — Part 04 — so the anon key alone can't read what it shouldn't).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Cup Shup is single-outlet today, so the login screen's staff picker
# (list_active_staff()) is scoped by this build-time value rather than a
# per-device setting. See docs/auth-design.md for the multi-outlet note.
# Matches outlets.id seeded in 0004_seed.sql.
NEXT_PUBLIC_SUPABASE_OUTLET_ID=00000000-0000-0000-0000-000000000001

# NEVER prefix this with NEXT_PUBLIC_. It bypasses Row Level Security
# entirely and must only ever be read on the server (e.g. app/api/auth/pin,
# or a trusted webhook route like app/api/pra). If this leaks to the
# browser, your whole database is exposed.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Part 19 — local print agent (print-agent/, a separate program that
# runs on each terminal). Optional: this is already the default if left
# unset. Only needed if you changed print-agent/config.json's own "port".
NEXT_PUBLIC_PRINT_AGENT_URL=http://localhost:9100

# Part 19 — PRA eIMS. Leave both unset to use the built-in mock (clearly
# labelled "MOCK-..." on every receipt) — see app/api/pra/submit/route.ts.
# A PRA-registered integration vendor supplies the real values for these.
# PRA_API_URL=
# PRA_API_KEY=
# Local testing only — forces every PRA submission to fail, so you can
# watch the offline-queue/reconcile path (lib/pra.ts) actually run.
# PRA_MOCK_FORCE_FAIL=true
